.DS_Store

# ROMs: only test ROMs are tracked (no commercial ROMs, no Nintendo boot ROM)
roms/*
!roms/test/
!roms/test/**
*.gb
*.gbc
!roms/test/**/*.gb
!roms/test/**/*.gbc

# RTL build / sim outputs
build/
obj_dir/
sim_build/
results.xml
*.vcd
*.fst
*.asc
*.bit
sim/**/out/

# Firmware (ESP-IDF)
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock

# ML
ml/data/*
!ml/data/.gitkeep
ml/.venv/
__pycache__/
*.pyc
